{
  "name": "ai-script-studio",
  "version": "1.2.0",
  "description": "践行 - AI 剧本创作桌面工具",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shhsgff/ai-script-studio.git"
  },
  "homepage": "https://github.com/shhsgff/ai-script-studio#readme",
  "bugs": {
    "url": "https://github.com/shhsgff/ai-script-studio/issues"
  },
  "main": "electron/main.js",
  "author": "践行",
  "license": "MIT",
  "scripts": {
    "prebuild": "node scripts/make-icon.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "build:dir": "electron-builder --win --dir",
    "build": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:dir": "electron-builder --mac --dir --publish never"
  },
  "dependencies": {
    "docx": "^9.12.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jianxing.script",
    "productName": "践行",
    "copyright": "Copyright © 2025 践行",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "scripts/fake-dsh.js",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "践行",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2025 践行",
        "LSMinimumSystemVersion": "10.15.0"
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 560,
        "height": 400
      }
    }
  }
}
